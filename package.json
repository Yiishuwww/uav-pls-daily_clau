{
  "name": "uav-pls-daily",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily digest of physical-layer-security papers for UAV communications",
  "scripts": {
    "start": "node src/main.js",
    "backfill": "node src/main.js --days 90 --bootstrap",
    "render": "node src/main.js --days 1 --no-collect",
    "notify": "node scripts/notify.mjs",
    "push": "node scripts/push-notify.mjs",
    "preview": "node scripts/serve.mjs",
    "validate": "node scripts/validate.mjs",
    "worker:dev": "npx --yes wrangler dev",
    "worker:deploy": "npx --yes wrangler deploy",
    "build:tencent": "node scripts/build-tencent.mjs",
    "build:alibaba": "node scripts/build-alibaba.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5",
    "fast-xml-parser": "^5.2.5",
    "fastest-levenshtein": "^1.0.16",
    "yaml": "^2.8.1"
  }
}
